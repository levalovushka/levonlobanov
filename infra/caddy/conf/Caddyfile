# Static site with the shared assets (fonts) at /_shared/.
# Usage: import static <root dir>
(static) {
	encode zstd gzip

	handle_path /_shared/* {
		root * /srv/shared
		header /fonts/* Cache-Control "public, max-age=2592000"
		file_server
	}

	handle {
		root * {args[0]}
		file_server
	}
}

levonlobanov.com {
	import static /srv/site
}

www.levonlobanov.com {
	redir https://levonlobanov.com{uri} permanent
}

# Static subprojects from sites/<name>.

mosaic.levonlobanov.com {
	import static /srv/sites/mosaic
}

# Container subprojects: one block per subdomain, proxying to a container on the `web` network.
